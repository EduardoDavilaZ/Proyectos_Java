package ui;

import java.awt.*;
import javax.swing.*;

public class Vista extends JFrame implements Estilos{

	private JPanel jpnNorte;
	private JPanel jpnCentro;
	
	public Vista() {
		inicializarFrame();
	}

	private void inicializarFrame() {
		setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
		setResizable(true);
		setSize(700, 500);
		setLocationRelativeTo(null);
		setLayout(new BorderLayout());
		inicializarPaneles();
		setVisible(true);
	}
	
	private void inicializarPaneles() {
		jpnNorte = new JPanel();
		jpnCentro = new JPanel();
		
		jpnNorte.setPreferredSize(new Dimension(500, 50));
		jpnCentro.setPreferredSize(new Dimension(500, 650));
		
		jpnNorte.setBackground(fondo1);
		jpnCentro.setBackground(fondo2);
		
		componentesNorte();
		componentesCentro();
		
		add(jpnNorte, BorderLayout.NORTH);
		add(jpnCentro, BorderLayout.CENTER);
	}
	
	private void componentesNorte() { //Quiero que todos los componentes tengan el mismo ancho, así como un padding, porque el jlbTiempo esta ocupando más que los demás componentes. quiero saber por que el botón no responde al ponerle el setPreferedSize si ya se le está dando dimensiones en la interfaz Estilos.
		JLabel jlbTiempo = new JLabel("00:00");
		JButton jbtCara = new JButton();
		JLabel jlbBombas = new JLabel("0");
		
		jlbTiempo.setFont(fuente2);
		jlbBombas.setFont(fuente2);
		
		Estilos.configurarBoton(jbtCara);

		jpnNorte.setLayout(new GridLayout(1, 3, 20, 0));

	    // Para forzar que todos tengan el mismo tamaño
	    Dimension d = new Dimension(100, 50);
	    jlbTiempo.setPreferredSize(d);
	    jbtCara.setPreferredSize(d);
	    jlbBombas.setPreferredSize(d);

	    // Añadimos centrados
	    jpnNorte.add(jlbTiempo);
	    jpnNorte.add(jbtCara);
	    jpnNorte.add(jlbBombas);
	}
	
	
	private void componentesCentro() {
		// TODO Auto-generated method stub
		
	}

	public static void main(String[] args) {
		new Vista();
	}

}
