package ui;

import java.awt.*;
import javax.swing.*;

public class Vista extends JFrame implements Estilos{

	private JPanel jpnNorte;
	private JPanel jpnCentro;
	
	public Vista() {
		inicializarFrame();
	}

	private void inicializarFrame() {
		setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
		setResizable(true);
		setSize(700, 500);
		setLocationRelativeTo(null);
		setLayout(new BorderLayout());
		inicializarPaneles();
		setVisible(true);
	}
	
	private void inicializarPaneles() {
		jpnNorte = new JPanel();
		jpnCentro = new JPanel();
		
		jpnNorte.setPreferredSize(new Dimension(500, 70));
		jpnCentro.setPreferredSize(new Dimension(500, 650));
		
		jpnNorte.setBackground(fondo1);
		jpnCentro.setBackground(fondo2);
		
		componentesNorte();
		componentesCentro();
		
		add(jpnNorte, BorderLayout.NORTH);
		add(jpnCentro, BorderLayout.CENTER);
	}
	
	private void componentesNorte() {
		JLabel jlbTiempo = new JLabel("00:00");
		JButton jbtCara = new JButton();
		JLabel jlbBombas = new JLabel("0");

		jlbTiempo.setFont(fuente2);
		jlbBombas.setFont(fuente2);

		Estilos.configurarBoton(jbtCara);

		jpnNorte.setLayout(new GridLayout(1, 3, 20, 0));
		jpnNorte.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));

		// Crear paneles con BoxLayout vertical para centrar en Y
		JPanel pnlTiempo = new JPanel();
		JPanel pnlCara = new JPanel();
		JPanel pnlBombas = new JPanel();

		pnlTiempo.setLayout(new BoxLayout(pnlTiempo, BoxLayout.Y_AXIS));
		pnlCara.setLayout(new BoxLayout(pnlCara, BoxLayout.Y_AXIS));
		pnlBombas.setLayout(new BoxLayout(pnlBombas, BoxLayout.Y_AXIS));

		pnlTiempo.setOpaque(false);
		pnlCara.setOpaque(false);
		pnlBombas.setOpaque(false);

		Dimension tam = new Dimension(80, 50);
		jbtCara.setPreferredSize(tam);
		jbtCara.setMinimumSize(tam);
		jbtCara.setMaximumSize(tam);

		// Añadir pegamento vertical para centrar en eje Y
		pnlTiempo.add(Box.createVerticalGlue());
		pnlTiempo.add(jlbTiempo);
		pnlTiempo.add(Box.createVerticalGlue());

		pnlCara.add(Box.createVerticalGlue());
		pnlCara.add(jbtCara);
		pnlCara.add(Box.createVerticalGlue());

		pnlBombas.add(Box.createVerticalGlue());
		pnlBombas.add(jlbBombas);
		pnlBombas.add(Box.createVerticalGlue());

		jpnNorte.add(pnlTiempo);
		jpnNorte.add(pnlCara);
		jpnNorte.add(pnlBombas);
	}
	
	
	private void componentesCentro() {
		// TODO Auto-generated method stub
		
	}

	public static void main(String[] args) {
		new Vista();
	}

}
