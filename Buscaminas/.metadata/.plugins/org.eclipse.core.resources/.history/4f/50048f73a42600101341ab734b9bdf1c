	Font fuente3 = new Font("Comic Sans MS", Font.ITALIC, 16); 
	
	Color fondo1 = new Color(230, 230, 230); // Gris claro
	Color fondo2 = new Color(192, 192, 192); // Gris
	Color fondo3 = new Color(102, 102, 102); // Gris oscuro
	Color fondo4 = new Color(255, 255, 255); // Blanco
	
	
	public static void configurarBoton(JButton boton) {
	    boton.setPreferredSize(new Dimension(40, 40));
	    boton.setBackground(fondo2);
	    boton.setFocusPainted(false);
	    boton.setContentAreaFilled(false);
	    boton.setBorderPainted(false);

	    hover(boton, 30);
	}

	public static void configurarCasilla(JButton boton) {
	    boton.setPreferredSize(new Dimension(40, 40));
	    boton.setBackground(fondo2);
	    boton.setFont(fuente2);
	    boton.setFocusPainted(false);
	    boton.setContentAreaFilled(true);
	    boton.setBorderPainted(true);

	    hover(boton, 0);
	}
	
	public static void hover(JButton boton, int radio) {
	    boton.addMouseListener(new MouseAdapter() {
	        public void mouseEntered(MouseEvent e) {
	            boton.setBackground(fondo3);
	        }
	        public void mouseExited(MouseEvent e) {
	            if (boton instanceof Casilla && ((Casilla) boton).isAbierto()) { // Comprobar si está abierta
	                boton.setBackground(fondo4);
	            } else {
	                boton.setBackground(fondo2);
	            }
	        }
	    });

