package obj;

import java.awt.GridLayout;
import java.awt.Image;

import javax.swing.ImageIcon;
import javax.swing.JPanel;
import ui.Estilos;

public class TableroGrafico extends JPanel implements Estilos{

	protected int num;
	protected int bombas;
	public Tablero t;
	
	public TableroGrafico(int num, int bombas) {
		this.num = num;
		this.bombas = bombas;
		t = new Tablero(num, bombas);
		crearVentana();
	}
	
	public void crearVentana() {
		setSize(500, 650);
		setBackground(fondo1);
		dibujarTablero();
	}
	
	private void dibujarTablero() {
		setLayout(new GridLayout(num, num, 2, 2));
		for (int i = 0; i < num; i++) {
		    for (int j = 0; j < num; j++) {
		        Estilos.configurarCasilla(t.casillas[i][j]);
		        add(t.casillas[i][j]);
		    }
		}
	}
}
