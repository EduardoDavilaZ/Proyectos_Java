package ui;

import java.awt.*;
import javax.swing.*;

public class Vista extends JFrame implements Estilos{

	private JPanel jpnNorte;
	private JPanel jpnCentro;
	
	public Vista() {
		inicializarFrame();
	}

	private void inicializarFrame() {
		setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
		setResizable(true);
		setSize(700, 500);
		setLocationRelativeTo(null);
		setLayout(new BorderLayout());
		inicializarPaneles();
		setVisible(true);
	}
	
	private void inicializarPaneles() {
		jpnNorte = new JPanel();
		jpnCentro = new JPanel();
		
		jpnNorte.setPreferredSize(new Dimension(500, 70));
		jpnCentro.setPreferredSize(new Dimension(500, 650));
		
		jpnNorte.setBackground(fondo1);
		jpnCentro.setBackground(fondo2);
		
		componentesNorte();
		componentesCentro();
		
		add(jpnNorte, BorderLayout.NORTH);
		add(jpnCentro, BorderLayout.CENTER);
	}
	
	private void componentesNorte() {
		JLabel jlbTiempo = new JLabel("00:00");
		JButton jbtCara = new JButton();
		JLabel jlbBombas = new JLabel("0");
		
		jlbTiempo.setFont(fuente2);
		jlbBombas.setFont(fuente2);
		
		Estilos.configurarBoton(jbtCara);
		jbtCara.setIcon(new ImageIcon(new ImageIcon(getClass().getResource("/img/caraTriste.png")).getImage().getScaledInstance(40, 40, Image.SCALE_SMOOTH)));

		jpnNorte.setLayout(new GridLayout(1, 3, 20, 0));
		jpnNorte.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));

	    JPanel jpnTiempo = new JPanel(new FlowLayout(FlowLayout.CENTER, 0, 0));
	    JPanel jpnCara = new JPanel(new FlowLayout(FlowLayout.CENTER, 0, 0));
	    JPanel jpnBombas = new JPanel(new FlowLayout(FlowLayout.CENTER, 0, 0));

	    jpnTiempo.setOpaque(false);jpnCara.setOpaque(false);jpnBombas.setOpaque(false);
	    Dimension tam = new Dimension(80, 50);
	    jbtCara.setPreferredSize(tam);jbtCara.setMinimumSize(tam);jbtCara.setMaximumSize(tam);
	    jpnTiempo.add(jlbTiempo);jpnCara.add(jbtCara);jpnBombas.add(jlbBombas);

	    jpnNorte.add(jpnTiempo);
	    jpnNorte.add(jpnCara);
	    jpnNorte.add(jpnBombas);
	}
	
	
	private void componentesCentro() {
		// TODO Auto-generated method stub
		
	}

	public static void main(String[] args) {
		new Vista();
	}

}
